   "source": [
    "y_upper = NACA_0012_Curve (x)\n",
    "y_lower = -NACA_0012_Curve(x) \n",
    "\n",
    "\n",
    "plt.figure()\n",
    "plt.axis('equal')\n",
    "plt.plot(x,y_upper)\n",
