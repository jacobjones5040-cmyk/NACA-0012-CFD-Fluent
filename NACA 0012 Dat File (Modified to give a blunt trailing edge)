   "metadata": {},
   "outputs": [],
   "source": [
    "    n = 200 #number of points\n",
    "    x = 0.5 * (1 - np.cos(np.linspace(0, np.pi, n)))\n",
    "    y = np.zeros(np.size(x), dtype=float)\n",
    "    t = 0.12"
   ]
  },
  {
