   "source": [
    "def NACA_0012_Curve (x):\n",
    "   \n",
    "    y = 5 * t * (0.2969 * np.sqrt(x) - 0.126 * x - 0.3516 * x**2 + 0.2843 * x**3 - 0.1015 * x**4)\n",
    "        \n",
    "    return y\n",
    "    \n",
    "x[2]"
   ]
  },
